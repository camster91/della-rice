<article class="della-range-card">
  <a href="{{ range_product.url }}" class="della-range-image" aria-label="{{ range_product.title | escape }}">{% if range_product.featured_image %}{{ range_product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '260, 400, 550, 700', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', alt: range_product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a>
  <div class="della-range-meta"><p class="della-eyebrow">{{ range_product.type | escape }}</p><h3><a href="{{ range_product.url }}">{{ range_product.title | escape }}</a></h3><p class="della-range-price">{{ range_product.price | money }}{% if range_product.price_varies %}+{% endif %}</p></div>
  {% render 'della-quick-add', quick_product: range_product, section_id: section_id, context: 'range', show_quantity: show_quantity %}
</article>
