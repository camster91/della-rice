<article class="della-product-card">
  <a class="della-product-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '260, 400, 600, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'della-product-placeholder' }}{% endif %}</a>
  <div class="della-product-meta"><div><p class="della-eyebrow">{{ category | default: product.type | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% if product.selected_or_first_available_variant.weight > 0 %}<p>{{ product.selected_or_first_available_variant.weight | weight_with_unit }}</p>{% endif %}</div><div class="della-product-price">{{ product.price | money }}{% if product.price_varies %}<span>+</span>{% endif %}</div></div><a class="della-product-link" href="{{ product.url }}">{% if product.available %}View rice{% else %}View product{% endif %} →</a>
</article>
