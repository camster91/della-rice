<section id="store-finder" class="della-retail della-pad"><div><p class="della-eyebrow">Retail</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="della-button" href="{{ routes.all_products_collection_url }}">Shop online</a></div><div class="della-retail-panel">{% if section.settings.locator_url != blank %}<h3>Find a retailer</h3><p>Check nearby retailers and availability through our store finder.</p><a class="della-button" href="{{ section.settings.locator_url }}">Open store finder</a>{% else %}<h3>Looking for Della near you?</h3><p>Contact our team for retailer information. Please check availability with the retailer before visiting.</p><a class="della-button della-button--outline" href="/pages/contact">Ask our team</a>{% endif %}</div></section>
{% schema %}
{"name":"Della retail finder","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find Della near you."},{"type":"textarea","id":"text","label":"Description","default":"Shop our rice online or ask our team about retail options near you."},{"type":"url","id":"locator_url","label":"Verified store finder URL","info":"Add the approved retailer search URL. Without it, visitors are directed to the contact form."}],"presets":[{"name":"Della retail finder"}]}
{% endschema %}
