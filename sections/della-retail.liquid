<section id="store-finder" class="della-retail della-pad">
  <div>
    <p class="della-eyebrow">Retail</p>
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.text | escape }}</p>
    <a class="della-button" href="{{ routes.all_products_collection_url }}">Shop Della Rice</a>
  </div>
  <div class="della-retail-panel">
    {% if section.settings.locator_url != blank %}
      <h3>Find a retailer</h3>
      <p>Check nearby retailers and availability through our store finder.</p>
      <a class="della-button" href="{{ section.settings.locator_url }}">Open store finder</a>
    {% else %}
      <h3>Order directly from Della</h3>
      <p>Browse our current rice varieties and order from our online store. For product questions, contact our team.</p>
      <a class="della-button della-button--outline" href="/pages/contact">Ask a product question</a>
    {% endif %}
    {% assign catalogue = pages['wholesale-catalogue'] %}
    {% if catalogue != blank %}
      <p><strong>Buying for a business?</strong> Browse our rice varieties and product sell sheets in the <a href="{{ catalogue.url }}">wholesale catalogue</a>.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Della retail finder","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find Us"},{"type":"textarea","id":"text","label":"Description","default":"Shop the Della Rice collection online."},{"type":"url","id":"locator_url","label":"Verified store finder URL","info":"Add the approved retailer search URL. Without it, visitors are directed to the contact form."}],"presets":[{"name":"Della retail finder"}]}
{% endschema %}
