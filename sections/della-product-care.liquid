<section class="della-product-care" aria-labelledby="CareHeading-{{ section.id }}">
  <div class="della-care-heading"><p class="della-eyebrow">In your kitchen</p><h2 id="CareHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="della-care-grid">
    <article><span class="della-care-number" aria-hidden="true">01</span><h3>Cook your way</h3><p>For stovetop cooking, follow the directions on your package. Using a rice cooker or another appliance? Follow its manufacturer’s directions for the water amount, heat setting and cooking time.</p></article>
    <article><span class="della-care-number" aria-hidden="true">02</span><h3>Keep it fresh</h3>{% if product.type == 'Organic' or product.tags contains 'Organic' %}<p><strong>Organic product tip:</strong> Store uncooked organic rice in a tightly sealed, freezer-safe container in the freezer to help prevent pantry insects.</p>{% else %}<p>Keep uncooked rice in a tightly sealed, freezer-safe container in the freezer. Follow any storage instructions on your product packaging.</p>{% endif %}</article>
    <article><span class="della-care-number" aria-hidden="true">03</span><h3>A question about your rice?</h3><p>Check your current package for ingredients and allergen information, or send our team a note.</p><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }} ↗</a><a href="/pages/contact">More questions & answers →</a></article>
  </div>
</section>
{% style %}
  #shopify-section-{{ section.id }} .della-product-care{padding:clamp(40px,6vw,84px) max(24px,calc((100vw - 1200px)/2));background:var(--della-cream);color:var(--della-ink)}
  #shopify-section-{{ section.id }} h2{font-size:clamp(30px,3.2vw,48px);line-height:1.12;max-width:20ch;margin:12px 0 36px}
  #shopify-section-{{ section.id }} .della-care-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}
  #shopify-section-{{ section.id }} article{border-top:1px solid var(--della-rule);padding-top:20px;min-width:0}
  #shopify-section-{{ section.id }} .della-care-number{font-size:12px;letter-spacing:.08em}
  #shopify-section-{{ section.id }} h3{font:600 22px/1.3 Arial,Helvetica,sans-serif;text-transform:none;letter-spacing:0;margin:16px 0}
  #shopify-section-{{ section.id }} article p,#shopify-section-{{ section.id }} article a{font:400 18px/1.65 Arial,Helvetica,sans-serif}
  #shopify-section-{{ section.id }} article p{margin:0 0 14px}
  #shopify-section-{{ section.id }} article a{display:block;overflow-wrap:anywhere;text-underline-offset:4px;margin-top:10px}
  @media(max-width:749px){#shopify-section-{{ section.id }} .della-care-grid{grid-template-columns:1fr;gap:28px}#shopify-section-{{ section.id }} h2{margin-bottom:28px}}
{% endstyle %}
{% schema %}
{"name":"Della cooking and storage","settings":[{"type":"text","id":"heading","label":"Heading","default":"A little care. A lovely meal."},{"type":"text","id":"email","label":"Product questions email","default":"info@dellarice.com"}],"presets":[{"name":"Della cooking and storage"}]}
{% endschema %}
