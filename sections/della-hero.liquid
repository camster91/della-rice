<section class="della-hero" aria-labelledby="HeroTitle-{{ section.id }}" data-della-slideshow>
  <div class="della-hero-copy"><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="della-serif" id="HeroTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1><p class="della-lead">{{ section.settings.text | escape }}</p><div class="della-actions"><a class="della-button" href="{{ routes.all_products_collection_url }}">Shop all rice</a><a class="della-button della-button--outline" href="/pages/about">Meet the family</a></div>{% if section.blocks.size > 1 %}<div class="della-slide-controls" aria-label="Choose a highlight">{% for block in section.blocks %}<button type="button" data-della-slide="{{ forloop.index0 }}" aria-label="Show highlight {{ forloop.index }}: {{ block.settings.label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ forloop.index | prepend: '0' }}</button>{% endfor %}</div>{% endif %}</div>
  <div class="della-hero-media">{% for block in section.blocks %}<div class="della-slide" data-slide-panel="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 49vw, 100vw' }}{% else %}{% render 'della-image', key: block.settings.asset_key, alt: block.settings.label, eager: forloop.first %}{% endif %}</div>{% endfor %}</div>
</section>
{% schema %}
{"name":"Della hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The People’s Rice"},{"type":"text","id":"heading","label":"Heading","default":"From grain to table."},{"type":"textarea","id":"text","label":"Description","default":"An exquisite grain with exceptional flavor, fluffy texture, and thoughtful sourcing in the USA."}],"blocks":[{"type":"slide","name":"Highlight image","settings":[{"type":"text","id":"label","label":"Image description","default":"Della rice"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"asset_key","label":"Bundled image key","default":"home-imgContainer"}]}],"max_blocks":3,"presets":[{"name":"Della hero","blocks":[{"type":"slide"}]}]}
{% endschema %}
