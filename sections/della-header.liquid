<div class="della-announcement">{{ section.settings.announcement | escape }}</div>
<header class="della-header">
  <a class="della-logo" href="{{ routes.root_url }}" aria-label="Della Rice home">
    {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 284 | image_tag: width: 142, loading: 'eager', alt: 'Della — The Nicest Rice' }}{% else %}{% render 'della-image', key: 'home-imgImageDellaTheNicestRice', alt: 'Della — The Nicest Rice', eager: true %}{% endif %}
  </a>
  <nav class="della-nav" aria-label="Main navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% if link.links.size > 0 %}<details class="della-dropdown"><summary>{{ link.title | escape }}</summary><div class="della-submenu"><a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>{% endfor %}</div></details>
        {% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
      {% endfor %}
    {% else %}
      <details class="della-dropdown"><summary>Shop</summary><div class="della-submenu"><a href="{{ routes.all_products_collection_url }}">All rice</a><a href="{{ routes.all_products_collection_url }}#all-natural">All Natural</a><a href="{{ routes.all_products_collection_url }}#organic">Organic</a><a href="{{ routes.all_products_collection_url }}#regenerative">Regenerative</a></div></details>
      <a href="{{ pages['about'].url | default: '/pages/about' }}">About us</a>
      <a href="{{ pages['where-to-buy'].url | default: '/pages/where-to-buy' }}">Where to buy</a>
      <a href="{{ pages['wholesale'].url | default: '/pages/wholesale' }}">Wholesale</a>
      {% if blogs.recipes.articles_count > 0 %}<a href="{{ blogs.recipes.url }}">Recipes</a>{% endif %}
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}">Contact</a>
    {% endif %}
  </nav>
  <div class="della-header-actions"><a href="{{ routes.search_url }}" aria-label="Search the store" class="della-search-link">Search</a><a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="della-bag" aria-label="Bag, {{ cart.item_count }} items">{% render 'della-image', key: 'home-imgImage', alt: '', eager: true %}<span>Bag ({{ cart.item_count }})</span></a></div>
  <details class="della-mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="{{ routes.all_products_collection_url }}">Shop all rice</a><a href="/pages/about">About us</a><a href="/pages/where-to-buy">Where to buy</a><a href="/pages/wholesale">Wholesale</a>{% if blogs.recipes.articles_count > 0 %}<a href="{{ blogs.recipes.url }}">Recipes</a>{% endif %}<a href="/pages/contact">Contact us</a><a href="{{ routes.search_url }}">Search</a></nav></details>
</header>
{% schema %}
{"name":"Della header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"The People’s Rice · Family-owned since 1986 · Ready in 20 minutes"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Main menu"}]}
{% endschema %}
