{%- if page.handle == 'wholesale' -%}
  <section class="della-cta della-pad della-tone-yellow della-cta--inline">
    <div>
      <p class="della-eyebrow">For retail buyers</p>
      <h2>Explore the Della Rice catalogue</h2>
    </div>
    <p>Browse the range and open the sell sheets for product details.</p>
    <div class="della-actions">
      <a class="della-button" href="{{ pages['wholesale-catalogue'].url }}">View wholesale catalogue</a>
    </div>
  </section>
{%- endif -%}
<section class="della-wholesale della-pad" aria-label="Wholesale ordering platforms">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><p class="della-eyebrow">0{{ forloop.index }} · {{ block.settings.name | escape }}</p><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p><a class="della-button" href="{{ block.settings.url }}" target="_blank" rel="noopener">{{ block.settings.button | escape }} <span class="visually-hidden">(opens in a new window)</span> ↗</a></article>{% endfor %}</section>
{% schema %}
{"name":"Della wholesale platforms","blocks":[{"type":"platform","name":"Platform","settings":[{"type":"text","id":"name","label":"Name"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"},{"type":"text","id":"button","label":"Button"},{"type":"url","id":"url","label":"Link"}]}],"max_blocks":2,"presets":[{"name":"Della wholesale platforms"}]}
{% endschema %}
