<section class="della-benefits della-pad" aria-labelledby="Benefits-{{ section.id }}"><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Benefits-{{ section.id }}" class="della-serif">{{ section.settings.heading | escape }}</h2><p class="della-intro">{{ section.settings.text | escape }}</p><div class="della-benefit-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="della-eyebrow">0{{ forloop.index }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></section>
{% schema %}
{"name":"Della benefits","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Heartland warmth meets everyday excellence"},{"type":"text","id":"heading","label":"Heading","default":"The Nicest Rice"},{"type":"textarea","id":"text","label":"Description","default":"For 40 years, Della has honored the deep-rooted traditions of Arkansas rice growing. Every bag is a warm celebration of local growers and the communities they nourish."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"}]}],"max_blocks":3,"presets":[{"name":"Della benefits"}]}
{% endschema %}
