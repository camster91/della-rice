<section class="della-buying-paths" aria-label="Ways to buy Della">{% for block in section.blocks %}<article class="della-tone-{{ block.settings.tone }}" {{ block.shopify_attributes }}><span class="della-path-number">0{{ forloop.index }}</span><p class="della-eyebrow">{{ block.settings.label | escape }}</p><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p><a class="della-button della-button--outline" href="{{ block.settings.url }}">{{ block.settings.button | escape }}</a></article>{% endfor %}</section>
{% schema %}
{"name":"Della buying paths","blocks":[{"type":"path","name":"Buying path","settings":[{"type":"text","id":"label","label":"Label"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"},{"type":"text","id":"button","label":"Button"},{"type":"url","id":"url","label":"Link"},{"type":"select","id":"tone","label":"Colour","options":[{"value":"cream","label":"Cream"},{"value":"dark","label":"Dark"},{"value":"blue","label":"Blue"},{"value":"yellow","label":"Yellow"}],"default":"cream"}]}],"max_blocks":4,"presets":[{"name":"Della buying paths"}]}
{% endschema %}
