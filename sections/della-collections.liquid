<section class="della-collections della-pad"><div><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="della-serif">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="della-button" href="{{ routes.all_products_collection_url }}">See all varieties</a></div><nav class="della-collection-fan" aria-label="Explore Della rice collections">{% for block in section.blocks %}<a href="{{ routes.all_products_collection_url }}#{{ block.settings.anchor }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% else %}{% render 'della-image', key: block.settings.asset_key, alt: block.settings.heading %}{% endif %}<span>{{ block.settings.heading | escape }} →</span></a>{% endfor %}</nav></section>
{% schema %}
{"name":"Della collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Meet the Della family"},{"type":"text","id":"heading","label":"Heading","default":"Three ways to eat nicer."},{"type":"textarea","id":"text","label":"Description","default":"Every bag starts with quality. Choose the growing approach and variety that fit your table."}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"anchor","label":"Collection anchor"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"asset_key","label":"Bundled image key"}]}],"max_blocks":3,"presets":[{"name":"Della collections"}]}
{% endschema %}
