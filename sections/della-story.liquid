<section id="{{ section.settings.anchor | escape }}" class="della-story della-tone-{{ section.settings.tone }}{% if section.settings.reverse %} della-story--reverse{% endif %}">
  <div class="della-story-media">{% if section.settings.anchor == 'impact' %}
<della-community-gallery role="region" aria-roledescription="carousel" aria-label="Community and teaching photos">
  <div class="della-community-gallery__track" tabindex="0" aria-label="Photo slides. Use left and right arrow keys.">
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}<figure data-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1120 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', alt: block.settings.alt }}{% else %}<div class="della-community-gallery__placeholder"><span>Photo placeholder</span><strong>{{ block.settings.caption | escape }}</strong></div>{% endif %}
      {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
    </figure>{% endfor %}
  {% else %}
    {% assign placeholder_titles = 'Community moments|Cooking and teaching|Schools and learning' | split: '|' %}
    {% for title in placeholder_titles %}<figure data-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of 3"><div class="della-community-gallery__placeholder"><span>Photo placeholder</span><strong>{{ title }}</strong><p>Add an approved Della photo here.</p></div><figcaption>{{ title }}</figcaption></figure>{% endfor %}
  {% endif %}
  </div>
  <div class="della-community-gallery__controls"><button type="button" data-step="-1" aria-label="Previous community photo">← Previous</button><span data-count role="status" aria-live="polite" aria-atomic="true">1 / {% if section.blocks.size > 0 %}{{ section.blocks.size }}{% else %}3{% endif %}</span><button type="button" data-step="1" aria-label="Next community photo">Next →</button></div>
</della-community-gallery>
{% else %}{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 52vw, 100vw' }}{% else %}{% render 'della-image', key: section.settings.asset_key, alt: section.settings.image_alt %}{% endif %}{% endif %}</div><div class="della-story-copy"><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="della-button" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
</section>
<style>
  #shopify-section-{{ section.id }} .della-story-copy > .della-button { margin-top: 24px; }
</style>

{% if section.settings.anchor == 'impact' %}
<style>
#shopify-section-{{ section.id }} .della-story-media { padding: clamp(24px, 4vw, 56px); display: grid; align-items: center; }
della-community-gallery { display: block; width: 100%; max-width: 560px; min-width: 0; margin-inline: auto; }
.della-community-gallery__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: thin; }
.della-community-gallery__track figure { flex: 0 0 100%; min-width: 0; margin: 0; scroll-snap-align: start; }
.della-community-gallery__track img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: var(--della-tan); }
.della-community-gallery__placeholder { aspect-ratio: 4 / 3; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px; padding: 24px; background: var(--della-tan); color: var(--della-ink); border: 1px dashed currentColor; text-align: center; }
.della-community-gallery__placeholder span { font: 12px/1.5 Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
.della-community-gallery__placeholder strong { font: 600 clamp(22px, 2.2vw, 30px)/1.3 Arial, sans-serif; }
.della-community-gallery__placeholder p { font: 15px/1.5 Arial, sans-serif; margin: 0; }
.della-community-gallery__track figcaption { padding: 16px 0; font: 16px/1.5 Arial, sans-serif; }
.della-community-gallery__controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.della-community-gallery__controls button { min-height: 44px; padding: 10px 14px; border: 1px solid currentColor; border-radius: 4px; background: transparent; color: inherit; font: 600 14px/1.4 Arial, sans-serif; }
.della-community-gallery__controls button:disabled { opacity: .4; cursor: default; }
@media(max-width: 600px) { #shopify-section-{{ section.id }} .della-story-media { aspect-ratio: auto; padding: 24px; } }
</style>
<script>
if (!customElements.get('della-community-gallery')) {
  customElements.define('della-community-gallery', class extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      var track = this.querySelector('.della-community-gallery__track');
      var slides = this.querySelectorAll('[data-slide]');
      var previous = this.querySelector('[data-step="-1"]');
      var next = this.querySelector('[data-step="1"]');
      var counter = this.querySelector('[data-count]');
      function index() { return Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth))); }
      function update() { var current = index(); counter.textContent = (current + 1) + ' / ' + slides.length; previous.disabled = current === 0; next.disabled = current === slides.length - 1; }
      function move(step) { var target = Math.max(0, Math.min(slides.length - 1, index() + step)); track.scrollTo({left: target * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'}); }
      previous.addEventListener('click', function () { move(-1); });
      next.addEventListener('click', function () { move(1); });
      track.addEventListener('scroll', update, {passive: true});
      track.addEventListener('keydown', function (event) { if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); } });
      var lastWidth = track.clientWidth;
      this._galleryResizeObserver = new ResizeObserver(function () {
        var width = track.clientWidth;
        if (!width || width === lastWidth) return;
        var current = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / lastWidth)));
        lastWidth = width;
        track.scrollTo({left: current * width, behavior: 'instant'});
        update();
      });
      this._galleryResizeObserver.observe(track);
      update();
    }
    disconnectedCallback() {
      if (this._galleryResizeObserver) this._galleryResizeObserver.disconnect();
      delete this.dataset.ready;
    }
  });
}
</script>
{% endif %}
{% schema %}
{"name":"Della image and story","settings":[{"type":"text","id":"anchor","label":"Section anchor","default":"our-story"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Description"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"asset_key","label":"Bundled image key","default":"home-imgImageRicePlantsReadyForHarvestInAnArkansasField"},{"type":"text","id":"image_alt","label":"Image description","default":"Rice growing in an Arkansas field"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false},{"type":"select","id":"tone","label":"Colour","options":[{"value":"blue","label":"Blue"},{"value":"cream","label":"Cream"}],"default":"cream"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Della image and story"}],"blocks":[{"type":"community_photo","name":"Community photo","settings":[{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"alt","label":"Image description"},{"type":"text","id":"caption","label":"Caption"}]}],"max_blocks":8}
{% endschema %}
