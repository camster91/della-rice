<section id="{{ section.settings.anchor | escape }}" class="della-story della-tone-{{ section.settings.tone }}{% if section.settings.reverse %} della-story--reverse{% endif %}">
  <div class="della-story-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 52vw, 100vw' }}{% else %}{% render 'della-image', key: section.settings.asset_key, alt: section.settings.image_alt %}{% endif %}</div><div class="della-story-copy"><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="della-button" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
</section>
{% schema %}
{"name":"Della image and story","settings":[{"type":"text","id":"anchor","label":"Section anchor","default":"our-story"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Description"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"asset_key","label":"Bundled image key","default":"home-imgImageRicePlantsReadyForHarvestInAnArkansasField"},{"type":"text","id":"image_alt","label":"Image description","default":"Rice growing in an Arkansas field"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false},{"type":"select","id":"tone","label":"Colour","options":[{"value":"blue","label":"Blue"},{"value":"cream","label":"Cream"}],"default":"cream"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Della image and story"}]}
{% endschema %}
