<section id="{{ section.settings.anchor | escape }}" class="della-cta della-pad della-tone-{{ section.settings.tone }}{% if section.settings.inline %} della-cta--inline{% endif %}"><div><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.details != blank %}<div class="rte">{{ section.settings.details }}</div>{% endif %}<div class="della-actions">{% for block in section.blocks %}<a class="della-button{% unless forloop.first %} della-button--outline{% endunless %}" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endfor %}</div></section>
{% schema %}
{"name":"Della call to action","settings":[{"type":"text","id":"anchor","label":"Section anchor"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"},{"type":"richtext","id":"details","label":"Additional details"},{"type":"select","id":"tone","label":"Colour","options":[{"value":"tan","label":"Tan"},{"value":"yellow","label":"Yellow"},{"value":"cream","label":"Cream"}],"default":"yellow"},{"type":"checkbox","id":"inline","label":"Horizontal layout","default":false}],"blocks":[{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"Della call to action"}]}
{% endschema %}
