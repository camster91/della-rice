<section id="{{ section.settings.anchor | escape }}" class="della-cta della-pad della-tone-{{ section.settings.tone }}{% if section.settings.inline %} della-cta--inline{% endif %}"><div><p class="della-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% if section.settings.show_brand_graphics %}<div class="della-promise-graphics" aria-hidden="true"><img src="{{ 'della-wp-b4086b57-Group-3408-e1761737978889.png' | file_url }}" width="198" height="193" loading="lazy" alt=""><img src="{{ 'della-wp-57d7e60-Group-126.png' | file_url }}" width="308" height="195" loading="lazy" alt=""><img src="{{ 'della-wp-ed115d51-Group-3405-e1761738013898.png' | file_url }}" width="196" height="194" loading="lazy" alt=""></div>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}{% if section.settings.details != blank %}<div class="rte">{{ section.settings.details }}</div>{% endif %}<div class="della-actions">{% for block in section.blocks %}<a class="della-button{% unless forloop.first %} della-button--outline{% endunless %}" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endfor %}</div></section>
<style>
.della-promise-graphics{display:flex;justify-content:center;align-items:center;gap:28px;margin:24px auto 32px}
.della-promise-graphics img{width:72px;height:72px;object-fit:contain;display:block}
.della-promise-graphics img:nth-child(2){width:114px}
@media(max-width:600px){.della-promise-graphics{gap:20px;margin:20px auto 28px}.della-promise-graphics img{width:52px;height:52px}.della-promise-graphics img:nth-child(2){width:82px}}
</style>
{% schema %}
{"name":"Della call to action","settings":[{"type":"text","id":"anchor","label":"Section anchor"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Description"},{"type":"richtext","id":"details","label":"Additional details"},{"type":"select","id":"tone","label":"Colour","options":[{"value":"tan","label":"Tan"},{"value":"yellow","label":"Yellow"},{"value":"cream","label":"Cream"},{"value":"green","label":"Brand green"}],"default":"yellow"},{"type":"checkbox","id":"show_brand_graphics","label":"Show Della decorative graphics","default":false},{"type":"checkbox","id":"inline","label":"Horizontal layout","default":false}],"blocks":[{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"Della call to action"}]}
{% endschema %}
